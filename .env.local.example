# --- Supabase ---------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER prefix with VITE_ (that would expose it to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe -------------------------------------------------------------
# Dashboard → Developers → API keys (use test keys until you go live).
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Only needed client-side if you add Stripe Elements/embedded checkout later.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Agora (live video) --------------------------------------------------
# console.agora.io → Project Management → your project.
# App ID is public/client-safe; App Certificate is server-only (enables
# token security — required, don't run in "testing mode" with no cert
# once real users are on it).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- DoorDash Drive -------------------------------------------------------
# developer.doordash.com → Drive → Credentials
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
